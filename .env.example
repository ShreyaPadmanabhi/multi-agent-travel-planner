# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. Attractions, geocoding, itineraries, road
# routes and hotel listings all work with no keys at all.
# ---------------------------------------------------------------------------

# Flight offers from Duffel. Sign up free at https://app.duffel.com/join, then
# More -> Developers -> Access tokens -> create a TEST token (duffel_test_...).
# Test mode is free and returns test offers; a live token needs a funded account.
DUFFEL_ACCESS_TOKEN=

# Enables the ReAct supervisor (over the MCP tools), Whisper transcription,
# GPT-4o vision and structured intake extraction, plus itinerary tips.
# Without it the supervisor uses rules and intake uses captions/PDF/OCR + heuristics.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SUPERVISOR_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1
SUPERVISOR_MAX_STEPS=6

# Wikimedia and Nominatim require an identifying User-Agent with real contact
# info. Point this at your own repo or e-mail. Placeholder domains such as
# example.com are actively blocked by Nominatim.
CONTACT_URL=https://github.com/travelplanner

# Search tuning
PLACE_SEARCH_RADIUS_KM=15
PLACE_MIN_SITELINKS=6
HOTEL_SEARCH_RADIUS_KM=12
MUST_VISIT_RADIUS_KM=60

# Multimodal intake limits (Whisper rejects files over 25 MB)
INTAKE_MAX_MEDIA_MB=25
INTAKE_VIDEO_FRAMES=6
INTAKE_MAX_PDF_PAGES=30

API_HOST=127.0.0.1
API_PORT=8000
